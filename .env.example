# ===========================================
# ContentPilot - Environment Variables
# ===========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/fb_content_hub?schema=public"
# Direct (non-pooled) connection — required by prisma.config.ts for migrations
DIRECT_URL="postgresql://user:password@localhost:5432/fb_content_hub?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook Graph API
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# AI — active text stack: Groq (llama-3.3-70b-versatile)
GROQ_API_KEY="gsk_your-groq-api-key"
# AI — image generation: Google Gen AI (Imagen)
GEMINI_API_KEY="your-gemini-api-key"

# OpenAI (legacy — no longer used, kept for reference only)
OPENAI_API_KEY="sk-your-openai-api-key"

# Stripe
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Upstash QStash / Workflow — serverless publishing engine (app/api/posts/workflow)
QSTASH_TOKEN="your-qstash-token"
QSTASH_URL="https://qstash.upstash.io"
# Set this to the deployed app URL so Workflow can call its own endpoint
QSTASH_CURRENT_SIGNING_KEY="sig_your-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="sig_your-next-signing-key"

# Redis (legacy Bull queue — superseded by Upstash Workflow)
REDIS_URL="redis://localhost:6379"

# Resend (Email)
RESEND_API_KEY="re_your-resend-api-key"

# Cron Secret (for Vercel Cron)
CRON_SECRET="your-cron-secret"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
